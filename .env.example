# Twenty MCP Server Configuration (v1.19 Self-Hosted Fork)
# Copy this file to .env and fill in your actual values

# Required: Your Twenty CRM API Key
# Get this from: Settings > API & Webhooks > Generate API Key
TWENTY_API_KEY=your-twenty-api-key-here

# Required: Your Twenty instance URL (no trailing slash)
# Self-hosted examples:
#   https://crm.yourdomain.com
#   https://twenty.local
#   http://localhost:3000
TWENTY_BASE_URL=https://your-twenty-instance.com

# Optional: Skip TLS certificate verification (for self-signed certs)
# Only set this if your instance uses a self-signed or internal CA certificate
# NODE_TLS_REJECT_UNAUTHORIZED=0

# Optional: Debug logging (uncomment to enable)
# DEBUG=twenty-mcp:*

# ===== OAuth Authentication Configuration (Optional) =====
# Only needed for multi-user HTTP server deployments.
# For single-user stdio MCP (Claude Code/Desktop), skip this section.

# AUTH_ENABLED=false
# AUTH_PROVIDER=clerk
# REQUIRE_AUTH=false
# CLERK_PUBLISHABLE_KEY=pk_test_xxx
# CLERK_SECRET_KEY=sk_test_xxx
# CLERK_DOMAIN=your-app.clerk.accounts.dev
# API_KEY_ENCRYPTION_SECRET=your-32-byte-hex-string-here

# ===== Server Configuration (HTTP mode only) =====
# MCP_SERVER_URL=http://localhost:3000
